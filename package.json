{
  "name": "nodejs-url-shortener",
  "version": "1.1.0",
  "private": true,
  "description": "A simple URL shortener built with Node.js, Express, MongoDB and React.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
